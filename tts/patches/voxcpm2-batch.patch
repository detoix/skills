+std::array<std::vector<float>, 2> VoxCPM2Runtime::generate_pair(
+    const std::array<VoxCPM2BatchRequest, 2> & requests) {
+    clear_error();
+    if (!is_initialized) {
+        fail("paired generation requires an initialized runtime");
+        return {};
+    }
+    const auto & first = requests[0].params;
+    const auto & second = requests[1].params;
+    if (first.inference_timesteps != second.inference_timesteps || first.cfg_value != second.cfg_value) {
+        fail("paired generation requires matching solver steps and CFG");
+        return {};
+    }
+
+    DecodeState other;
+    llama_context * primary_base_ctx = base_lm.ctx;
+    size_t active_lane = 0;
+    const auto activate = [&](size_t lane) {
+        if (active_lane != lane) {
+            swap_decode_state(other);
+            base_lm.ctx = lane == 0 ? primary_base_ctx : alternate_base_ctx.get();
+            residual_lm.alternate_kv = lane == 0 ? nullptr : alternate_residual_kv.get();
+            active_lane = lane;
+        }
+    };
+    // Restore the public primary state and context even if a lane fails.
+    struct RestorePrimaryLane {
+        const decltype(activate) & restore;
+        ~RestorePrimaryLane() { restore(0); }
+    } restore_primary{activate};
+
+    std::array<VoxCPM2GenerateParams, 2> params{first, second};
+    for (size_t lane = 0; lane < requests.size(); ++lane) {
+        const auto & request = requests[lane];
+        auto & lane_params = params[lane];
+        auto tokens = tokenize_text(request.prompt_text + request.text, false, true);
+        if (tokens.empty()) {
+            if (last_error_msg.empty()) {
+                fail("text tokenization produced no tokens");
+            }
+            return {};
+        }
+        VoxCPM2PrefillInputs inputs;
+        if (request.prompt_feat.empty()) {
+            if (lane_params.max_steps >= 200) {
+                const int auto_steps = std::max(15, static_cast<int>(tokens.size()) * 3 + 15);
+                lane_params.max_steps = std::min(auto_steps, lane_params.max_steps);
+            }
+            if (lane_params.append_audio_start && tokens.back() != kAudioStartToken) {
+                tokens.push_back(kAudioStartToken);
+            }
+            inputs.token_ids = std::move(tokens);
+        } else if (!build_continuation_prefill_inputs(tokens, request.prompt_feat, lane_params.append_audio_start, inputs)) {
+            return {};
+        }
+        if (lane == 1 && !ensure_alternate_context(inputs.token_ids.size(), lane_params.max_steps)) {
+            return {};
+        }
+        activate(lane);
+        rng.seed(lane_params.seed);
+        if (!prefill(inputs)) {
+            return {};
+        }
+    }
+
+    std::array<int, 2> steps{0, 0};
+    std::array<bool, 2> finished{params[0].max_steps <= 0, params[1].max_steps <= 0};
+    const auto record_step = [&](size_t lane, const VoxCPM2DecodeStepResult & result) {
+        const auto & lane_params = params[lane];
+        const bool predicted_stop =
+            lane_params.stop_on_predictor && steps[lane] > lane_params.min_steps && result.should_stop;
+        ++steps[lane];
+        finished[lane] = predicted_stop || steps[lane] >= lane_params.max_steps;
+    };
+    int paired_steps = 0;
+    while (!finished[0] && !finished[1]) {
+        std::array<std::vector<float>, 2> noise;
+        for (size_t lane = 0; lane < noise.size(); ++lane) {
+            activate(lane);
+            if (params[lane].seed != 0) {
+                rng.seed(params[lane].seed + static_cast<uint32_t>(current_position));
+            }
+            noise[lane] = random_noise();
+            for (float & value : noise[lane]) {
+                value *= params[lane].temperature;
+            }
+        }
+
+        activate(0);
+        std::array<VoxCPM2DecodeStepResult, 2> results;
+        if (!run_pair_front_half(noise, other, first, results)) {
+            return {};
+        }
+        for (size_t lane = 0; lane < results.size(); ++lane) {
+            activate(lane);
+            if (!finish_decode_step(results[lane])) {
+                return {};
+            }
+            record_step(lane, results[lane]);
+        }
+        ++paired_steps;
+    }
+
+    std::array<std::vector<float>, 2> waveforms;
+    for (size_t lane = 0; lane < waveforms.size(); ++lane) {
+        activate(lane);
+        while (!finished[lane]) {
+            const auto result = decode_step(params[lane]);
+            if (result.latent_patch.empty() || !last_error_msg.empty()) {
+                return {};
+            }
+            record_step(lane, result);
+        }
+        waveforms[lane] = decode_to_waveform(params[lane].target_sr);
+        if (waveforms[lane].empty()) {
+            return {};
+        }
+    }
+    LOG_INF("VoxCPM2Runtime: paired decode ran %d paired and %d single-line patches\n",
+            paired_steps, steps[0] + steps[1] - 2 * paired_steps);
+    return waveforms;
+}
