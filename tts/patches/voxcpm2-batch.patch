+void VoxCPM2Runtime::swap_decode_state(DecodeState & other) {
+    lm_hidden.swap(other.lm_hidden);
+    residual_hidden.swap(other.residual_hidden);
+    prefix_feat_cond.swap(other.prefix_feat_cond);
+    residual_input_history.swap(other.residual_input_history);
