+static VoxCPM2GenerateParams generation_params(const CliConfig & cfg) {
+    VoxCPM2GenerateParams params;
+    params.max_steps           = cfg.max_steps;
+    params.inference_timesteps = cfg.timesteps;
+    params.cfg_value           = cfg.cfg_value;
+    params.temperature         = cfg.temperature;
+    params.seed                = static_cast<uint32_t>(cfg.seed);
+    return params;
+}
+
+struct BatchRow {
+    std::string text;
+    std::string output;
+    std::string prompt_text;
+    const std::vector<float> * prompt_feat = nullptr;
+    size_t row = 0;
+    VoxCPM2GenerateParams params;
+
+    VoxCPM2BatchRequest to_request() const { return {text, prompt_text, *prompt_feat, params}; }
+};
+
+static bool write_batch_row(const BatchRow & row, const std::vector<float> & wav, double elapsed,
+                            VoxCPM2Runtime & runtime) {
+    if (wav.empty()) {
+        LOG_ERR("Batch row %zu failed: %s\n", row.row, runtime.last_error().c_str());
+        return false;
+    }
+    const int sample_rate = runtime.sample_rate();
+    report_stats(wav, sample_rate, elapsed);
+    if (!write_wav(row.output, wav, sample_rate)) {
+        return false;
+    }
+    common_log_flush(common_log_main());
+    std::printf("voxcpm2-batch-complete %zu\n", row.row);
+    std::fflush(stdout);
+    return true;
+}
+
+static bool run_batch_rows(const std::array<BatchRow, 2> & rows, int count,
+                           VoxCPM2Runtime & runtime, std::chrono::steady_clock::time_point start) {
+    std::array<std::vector<float>, 2> wavs;
+    if (count == 2) {
+        wavs = runtime.generate_pair({rows[0].to_request(), rows[1].to_request()});
+    } else {
+        const BatchRow & row = rows[0];
+        if (row.params.seed == 0) {
+            // A fresh standalone CLI starts with a zero-seeded RNG.
+            runtime.reset_rng();
+        }
+        wavs[0] = row.prompt_feat->empty()
+            ? runtime.generate(row.text, row.params)
+            : runtime.generate_with_continuation_features(row.text, row.prompt_text, *row.prompt_feat, row.params);
+    }
+    const double elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+    if (count == 2) {
+        LOG_INF("VoxCPM2: finished pair in %.3fs\n", elapsed);
+    }
+    for (int i = 0; i < count; ++i) {
+        if (!write_batch_row(rows[i], wavs[i], elapsed, runtime)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int run_batch(const CliConfig & cfg) {
+    std::ifstream requests(cfg.batch_path);
+    if (!requests) {
+        LOG_ERR("Cannot open batch requests: %s\n", cfg.batch_path.c_str());
+        return 1;
+    }
+
+    VoxCPM2Runtime runtime;
+    if (!runtime.init(cfg.base_lm_path, cfg.acoustic_path, cfg.n_gpu_layers, cfg.use_gpu)) {
+        LOG_ERR("Failed to initialize VoxCPM2 runtime: %s\n", runtime.last_error().c_str());
+        return 1;
+    }
+
+    const auto params = generation_params(cfg);
+    const std::vector<float> no_prompt;
+    std::unordered_map<std::string, std::vector<float>> prompt_features;
+    std::array<BatchRow, 2> rows;
+    int count = 0;
+    auto start = std::chrono::steady_clock::now();
+    size_t row = 0;
+    for (std::string line; std::getline(requests, line);) {
+        ++row;
+        try {
+            if (count == 0) {
+                start = std::chrono::steady_clock::now();
+            }
+            auto request = nlohmann::json::parse(line);
+            BatchRow & current = rows[count];
+            current.text = request.at("text").get<std::string>();
+            current.output = request.at("output").get<std::string>();
+            current.prompt_text = request.value("prompt_text", std::string{});
+            current.row = row;
+            current.params = params;
+            current.prompt_feat = &no_prompt;
+            const auto & seed = request.at("seed");
+            const auto prompt_wav = request.value("prompt_wav", std::string{});
+            if (current.text.empty() || current.output.empty() || prompt_wav.empty() != current.prompt_text.empty() ||
+                !seed.is_number_unsigned() || seed.get<uint64_t>() > std::numeric_limits<uint32_t>::max()) {
+                LOG_ERR("Invalid text, output, prompt or seed in batch row %zu\n", row);
+                return 1;
+            }
+            current.params.seed = seed.get<uint32_t>();
+
+            if (!prompt_wav.empty()) {
+                auto cached = prompt_features.find(prompt_wav);
+                if (cached == prompt_features.end()) {
+                    int sample_rate = 0;
+                    const auto pcm = load_wav_mono(prompt_wav, sample_rate);
+                    if (pcm.empty()) {
+                        LOG_ERR("Failed to load prompt for batch row %zu\n", row);
+                        return 1;
+                    }
+                    auto features = runtime.encode_reference_audio(pcm, sample_rate);
+                    if (features.empty()) {
+                        LOG_ERR("Failed to encode prompt for batch row %zu: %s\n", row, runtime.last_error().c_str());
+                        return 1;
+                    }
+                    cached = prompt_features.emplace(prompt_wav, std::move(features)).first;
+                }
+                current.prompt_feat = &cached->second;
+            }
+            ++count;
+            if (count == cfg.batch_rows) {
+                if (!run_batch_rows(rows, count, runtime, start)) {
+                    return 1;
+                }
+                count = 0;
+            }
+        } catch (const nlohmann::json::exception & e) {
+            LOG_ERR("Invalid JSON in batch row %zu: %s\n", row, e.what());
+            return 1;
+        }
+    }
+    if (!requests.eof() || row == 0) {
+        LOG_ERR("No batch requests or error reading %s\n", cfg.batch_path.c_str());
+        return 1;
+    }
+    if (count > 0 && !run_batch_rows(rows, count, runtime, start)) {
+        return 1;
+    }
+    return 0;
+}
