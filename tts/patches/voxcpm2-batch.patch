+void LocDiTModel::build_batch_attention(ggml_context * ctx,
+                                       int            branch_len,
+                                       ggml_tensor ** positions,
+                                       ggml_tensor ** mask) const {
+    constexpr int n_branches = 4;
+    constexpr int mask_padding = 256;
+    const int total_len = branch_len * n_branches;
+    const int padded_len = GGML_PAD(total_len, mask_padding);
+    GGML_ASSERT(total_len <= config.transformer.max_length);
+    GGML_ASSERT(config.transformer.no_rope || config.transformer.rope_original_max <= 1 ||
+                total_len <= config.transformer.rope_original_max);
+
+    const float inv_branch_len = 1.0f / static_cast<float>(branch_len);
+    ggml_tensor * token_ids = ggml_arange(ctx, 0.0f, static_cast<float>(total_len), 1.0f);
+    ggml_tensor * key_branch = ggml_floor(ctx, ggml_scale_bias(ctx, token_ids, inv_branch_len, 0.5f * inv_branch_len));
+    *positions = ggml_cast(ctx, ggml_sub(ctx, token_ids, ggml_scale(ctx, key_branch, branch_len)), GGML_TYPE_I32);
+
+    ggml_tensor * queries = ggml_arange(ctx, 0.0f, static_cast<float>(padded_len), 1.0f);
+    ggml_tensor * query_branch = ggml_floor(ctx, ggml_scale_bias(ctx, queries, inv_branch_len, 0.5f * inv_branch_len));
+    query_branch = ggml_clamp(ctx, query_branch, 0.0f, n_branches - 1.0f);
+    query_branch = ggml_reshape_2d(ctx, query_branch, 1, padded_len);
+    key_branch = ggml_repeat_4d(ctx, key_branch, total_len, padded_len, 1, 1);
+    ggml_tensor * different_branch =
+        ggml_clamp(ctx, ggml_abs(ctx, ggml_sub(ctx, key_branch, query_branch)), 0.0f, 1.0f);
+    *mask = ggml_cont(ctx, ggml_cast(ctx, ggml_scale(ctx, different_branch, -1.0e9f), GGML_TYPE_F16));
+}
+
+void LocDiTModel::forward_cfg_batch_projected(ggml_context *                ctx,
+                                              ggml_tensor *                 x_proj,
+                                              ggml_tensor *                 mu,
+                                              ggml_tensor *                 time_token,
+                                              ggml_tensor *                 cond_proj,
+                                              ggml_tensor *                 positions,
+                                              ggml_tensor *                 mask,
+                                              int                           seq_len,
+                                              int                           prefix_len,
+                                              std::array<ggml_tensor *, 2> & conditioned,
+                                              std::array<ggml_tensor *, 2> & unconditioned) const {
+    const int hidden_size = config.transformer.hidden_size;
+    const int mu_tokens = static_cast<int>(mu->ne[0] / hidden_size);
+    const int generated_prefix_tokens = config.combine_mu_time ? 1 : mu_tokens + 1;
+    const int branch_len = generated_prefix_tokens + prefix_len + seq_len;
+    std::array<ggml_tensor *, 2> cfg_pairs{};
+
+    for (size_t lane = 0; lane < cfg_pairs.size(); ++lane) {
+        ggml_tensor * mu_lane = ggml_view_1d(ctx, mu, mu->ne[0], lane * mu->nb[1]);
+        ggml_tensor * mu_prefix = reshape_mu_tokens(ctx, mu_lane);
+        ggml_tensor * zero_mu = ggml_scale(ctx, mu_prefix, 0.0f);
+        ggml_tensor * positive_prefix = nullptr;
+        ggml_tensor * negative_prefix = nullptr;
+        if (config.combine_mu_time) {
+            GGML_ASSERT(mu_tokens == 1);
+            positive_prefix = ggml_add(ctx, mu_prefix, time_token);
+            negative_prefix = ggml_add(ctx, zero_mu, time_token);
+        } else {
+            positive_prefix = ggml_concat(ctx, mu_prefix, time_token, 1);
+            negative_prefix = ggml_concat(ctx, zero_mu, time_token, 1);
+        }
+
+        ggml_tensor * patch_tokens =
+            ggml_view_2d(ctx, x_proj, hidden_size, seq_len, x_proj->nb[1], lane * seq_len * x_proj->nb[1]);
+        if (cond_proj) {
+            ggml_tensor * condition_tokens = ggml_view_2d(
+                ctx, cond_proj, hidden_size, prefix_len, cond_proj->nb[1], lane * prefix_len * cond_proj->nb[1]);
+            patch_tokens = ggml_concat(ctx, condition_tokens, patch_tokens, 1);
+        }
+        ggml_tensor * positive = ggml_concat(ctx, positive_prefix, patch_tokens, 1);
+        ggml_tensor * negative = ggml_concat(ctx, negative_prefix, patch_tokens, 1);
+        cfg_pairs[lane] = ggml_concat(ctx, positive, negative, 1);
+    }
+
+    ggml_tensor * branches = ggml_concat(ctx, cfg_pairs[0], cfg_pairs[1], 1);
+    ggml_tensor * hidden =
+        voxcpm2_transformer_forward(ctx, config.transformer, weights.transformer, branches, positions, mask);
+    std::array<ggml_tensor *, 2> output_pairs{};
+    for (size_t lane = 0; lane < output_pairs.size(); ++lane) {
+        const size_t offset = (2 * lane * branch_len + generated_prefix_tokens + prefix_len) * hidden->nb[1];
+        ggml_tensor * positive = ggml_view_2d(ctx, hidden, hidden_size, seq_len, hidden->nb[1], offset);
+        ggml_tensor * negative =
+            ggml_view_2d(ctx, hidden, hidden_size, seq_len, hidden->nb[1], offset + branch_len * hidden->nb[1]);
+        output_pairs[lane] = ggml_concat(ctx, positive, negative, 1);
+    }
+    ggml_tensor * projected = voxcpm2_linear(ctx, weights.out_proj_weight, weights.out_proj_bias,
+                                           ggml_concat(ctx, output_pairs[0], output_pairs[1], 1));
+    for (size_t lane = 0; lane < output_pairs.size(); ++lane) {
+        const size_t offset = 2 * lane * seq_len * projected->nb[1];
+        conditioned[lane] = ggml_view_2d(ctx, projected, config.feat_dim, seq_len, projected->nb[1], offset);
+        unconditioned[lane] = ggml_view_2d(ctx, projected, config.feat_dim, seq_len, projected->nb[1],
+                                          offset + seq_len * projected->nb[1]);
+    }
+}
