+bool VoxCPM2Runtime::ensure_alternate_context(size_t prefill_tokens, int max_steps) {
+    const uint32_t base_limit = llama_n_ctx(base_lm.ctx);
+    const auto & residual_cfg = residual_lm.config;
+    const uint32_t residual_limit = static_cast<uint32_t>(residual_cfg.max_length);
+    const uint64_t required = prefill_tokens + static_cast<uint64_t>(std::max(0, max_steps));
+    // llama.cpp rounds its context capacity to 256. Use the same allocation
+    // granularity for the residual cache and keep both existing context limits.
+    const uint32_t requested = static_cast<uint32_t>(std::min<uint64_t>(required, std::max(base_limit, residual_limit)));
+    const uint32_t rounded = GGML_PAD(std::max(1u, requested), 256);
+    const uint32_t base_capacity = std::min(rounded, base_limit);
+    const uint32_t residual_capacity = std::min(rounded, residual_limit);
+
+    if (!alternate_base_ctx || llama_n_ctx(alternate_base_ctx.get()) < base_capacity) {
+        auto context_params = base_lm.cparams;
+        context_params.n_ctx = base_capacity;
+        alternate_base_ctx.reset();
+        alternate_base_ctx.reset(llama_init_from_model(base_lm.model, context_params));
+        if (!alternate_base_ctx) {
+            return fail("failed to initialize second BaseLM context");
+        }
+        llama_set_n_threads(alternate_base_ctx.get(), llama_n_threads(base_lm.ctx), llama_n_threads_batch(base_lm.ctx));
+    }
+    if (!alternate_residual_kv || static_cast<uint32_t>(alternate_residual_kv->max_length) < residual_capacity) {
+        alternate_residual_kv.reset();
+        auto cache = std::make_unique<VoxCPM2KVCache>();
+        if (!cache->init(residual_cfg.n_layer, residual_cfg.n_kv_heads, residual_capacity, residual_cfg.head_dim, backend)) {
+            return fail("failed to initialize second ResidualLM cache");
+        }
+        alternate_residual_kv = std::move(cache);
+    }
+    LOG_INF("VoxCPM2Runtime: second lane context (prefill=%zu, max_steps=%d, BaseLM=%u/%u, ResidualLM=%d/%u, backend=%s)\n",
+            prefill_tokens, max_steps, llama_n_ctx(alternate_base_ctx.get()), base_limit,
+            alternate_residual_kv->max_length, residual_limit, ggml_backend_name(backend));
+    return true;
+}
